# Edge Function environment variables
# Copy this file to supabase/functions/.env for local development.
# For production, set these with: npx supabase secrets set --env-file <file>
# NEVER commit a file containing actual secrets.

# Required: Your app's public URL (used to build invite links)
APP_URL=https://your-app.pages.dev

# Optional: Email provider API key (Resend, SendGrid, etc.)
# If not set, invitations work via link sharing only — no email delivery.
EMAIL_PROVIDER_API_KEY=

# Optional: Sender email address for invitation emails
INVITE_FROM_EMAIL=noreply@your-app.com
